generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  COURIER
  ADMIN
}

enum AuthChallengeType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  PHONE_CHANGE
}

model User {
  id String @id @default(uuid()) @db.Uuid

  role UserRole @default(CLIENT)

  name         String @db.VarChar(80)
  email        String @unique @db.VarChar(320)
  phone        String @unique @db.VarChar(32)
  passwordHash String @map("password_hash") @db.VarChar(255)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions       Session[]
  authChallenges AuthChallenge[]

  @@map("users")
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(128)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthChallenge {
  id String @id @default(uuid()) @db.Uuid

  userId String            @map("user_id") @db.Uuid
  type   AuthChallengeType

  secretHash String  @map("secret_hash") @db.VarChar(255)
  target     String? @db.VarChar(320)

  attempts Int @default(0)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, secretHash])
  @@index([userId, type, expiresAt])
  @@index([expiresAt])
  @@map("auth_challenges")
}
