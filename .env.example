# Runtime connection used by application code. Use the provider's pooled URL when available.
DATABASE_URL=

# Direct, non-pooled connection used by Prisma CLI and migrations.
# Must target the same logical database as DATABASE_URL.
DIRECT_URL=

# Required in production. Public base URL used to create email links and validate request origins.
APP_URL=

# Transactional email credentials and verified sender address.
RESEND_API_KEY=
EMAIL_FROM=

# Generate a random value with at least 32 characters for production.
AUTH_RATE_LIMIT_SECRET=

# Self-hosted production only: header overwritten by your trusted reverse proxy.
# Allowed values: x-forwarded-for, x-real-ip, x-vercel-forwarded-for. Leave empty on Vercel.
TRUSTED_PROXY_HEADER=

# Draft legal pages. Complete and review these values before production release.
# Values are rendered as plain text; missing values do not fail the build.
LEGAL_OPERATOR_NAME=
# Free-text registration/tax identifiers (for example, KRS/NIP where applicable).
LEGAL_OPERATOR_REGISTRATION=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=
LEGAL_JURISDICTION=

# Set to true only after qualified legal review and after all LEGAL_* fields above are complete.
LEGAL_DOCUMENTS_REVIEWED=false
