DATABASE_URL=
DIRECT_URL=

# Public base URL used to create email links and validate request origins.
APP_URL=

# Transactional email credentials and verified sender address.
RESEND_API_KEY=
EMAIL_FROM=

# Generate a random value with at least 32 characters for production.
AUTH_RATE_LIMIT_SECRET=

# Draft legal pages. Complete and review these values before production release.
# Values are rendered as plain text; missing values do not fail the build.
LEGAL_OPERATOR_NAME=
# Free-text registration/tax identifiers (for example, KRS/NIP where applicable).
LEGAL_OPERATOR_REGISTRATION=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=
LEGAL_JURISDICTION=

# Set to true only after qualified legal review and after all LEGAL_* fields above are complete.
LEGAL_DOCUMENTS_REVIEWED=false
